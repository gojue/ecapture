[Unit]
Description=eCapture privileged E2E against a verified job or administrator bundle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/lib/ecapture-e2e
Environment=PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/ecapture-e2e-job
ExecStopPost=/usr/bin/python3 /usr/local/libexec/ecapture-e2e-finish.py
TimeoutStartSec=30min
TimeoutStopSec=45s
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=true
