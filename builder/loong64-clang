#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=builder/loong64-toolchain.sh
source "$(dirname "$0")/loong64-toolchain.sh"
driver="${LOONG64_CLANG_DRIVER:-clang-$llvm_major}"

# Make preflight checks the actual LLVM major once; pin the driver name here.
case "$driver" in
    "clang-$llvm_major"|"clang++-$llvm_major") ;;
    *)
        echo "Loong64 compiler must be clang-$llvm_major or clang++-$llvm_major; found $driver" >&2
        exit 1
        ;;
esac
if ! command -v "$driver" >/dev/null 2>&1; then
    echo "missing required Loong64 compiler: $driver" >&2
    exit 1
fi
if [[ ! -d "$sysroot" ]]; then
    echo "Loong64 sysroot is unavailable: $sysroot" >&2
    exit 1
fi
if [[ ! -d "$target_root/include" || ! -d "$target_libdir" ]]; then
    echo "Loong64 target root is unavailable: $target_root" >&2
    exit 1
fi
if [[ ! -f "$runtime_dir/libgcc.a" ]]; then
    echo "Loong64 libgcc runtime is unavailable: $runtime_dir/libgcc.a" >&2
    exit 1
fi

args=(
    --target=loongarch64-linux-gnu
    -mabi=lp64d
    --sysroot="$sysroot"
    -isystem "$target_root/include"
    --gcc-install-dir="$runtime_dir"
)

linker_args=()
link_action=1
for arg in "$@"; do
    case "$arg" in
        -c|-E|-S|-M|-MM|-fsyntax-only)
            link_action=0
            break
            ;;
    esac
done
if [[ "$link_action" == "1" ]]; then
    args+=(
        -L"$target_libdir"
        --rtlib=libgcc
        -L"$runtime_dir"
    )
    # Pin the versioned linker even when unversioned ld.lld is older.
    lld_path=$(command -v ld.lld-22) || {
        echo 'missing required Loong64 linker: ld.lld-22' >&2
        exit 1
    }
    linker_args=(-fuse-ld=lld "--ld-path=$lld_path")
fi

if [[ "${LOONG64_TOOLCHAIN_TRACE:-0}" == "1" ]]; then
    printf '[loong64-toolchain]' >&2
    printf ' %q' "$driver" "${args[@]}" "$@" "${linker_args[@]}" >&2
    printf '\n' >&2
fi
exec "$driver" "${args[@]}" "$@" "${linker_args[@]}"
